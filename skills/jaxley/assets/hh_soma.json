{
  "name": "hh_soma",
  "description": "Single-compartment Hodgkin-Huxley soma (radius 10 um, length 20 um). The channel values are the Jaxley HH defaults and double as the ground truth for the synthetic round trip in SKILL.md.",
  "morphology": {"type": "single_compartment"},
  "v_init": -65.0,
  "channels": [
    {"channel": "HH", "group": "all"}
  ],
  "parameters": [
    {"key": "radius", "value": 10.0, "group": "all"},
    {"key": "length", "value": 20.0, "group": "all"},
    {"key": "axial_resistivity", "value": 100.0, "group": "all"},
    {"key": "capacitance", "value": 1.0, "group": "all"},
    {"key": "HH_gNa", "value": 0.12, "group": "all"},
    {"key": "HH_gK", "value": 0.036, "group": "all"},
    {"key": "HH_gLeak", "value": 0.0003, "group": "all"}
  ],
  "trainable": [
    {"key": "HH_gNa", "group": "all", "lower": 0.01, "upper": 0.5},
    {"key": "HH_gK", "group": "all", "lower": 0.001, "upper": 0.2},
    {"key": "HH_gLeak", "group": "all", "lower": 1e-05, "upper": 0.01}
  ]
}
